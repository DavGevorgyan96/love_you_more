{
  "name": "love-you-more",
  "private": true,
  "description": "React + Tailwind + Express + Nodemailer",
  "scripts": {
    "install:all": "npm install && npm install --prefix client",
    "dev:server": "node server.js",
    "dev:client": "npm run dev --prefix client",
    "build:client": "npm run build --prefix client",
    "build:vercel": "npm run build:client && node scripts/copy-dist.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "@types/node": "^22.19.10",
    "vercel": "^47.0.0"
  }
}
